{
  "mcpServers": {
    "MongoDB": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@latest", "--readOnly"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "mongodb://localhost:27017",
        "MDB_MCP_READ_ONLY": "true"
      }
    },
    "Upstox MCP": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.upstox.com/mcp"]
    }
  }
}
